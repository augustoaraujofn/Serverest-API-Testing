    {
      "name": "Login",
      "item": [
        {
          "name": "Realizar login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code deve ser 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta deve conter token de autorização', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('authorization');",
                  "    pm.expect(data.authorization).to.be.a('string').and.not.empty;",
                  "    const token = data.authorization.replace(/^Bearer\\s+/i, '');",
                  "    pm.expect(token).to.not.be.empty;",
                  "    pm.collectionVariables.set('user_token', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
